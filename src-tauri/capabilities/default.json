{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "prismlauncher",
          "cmd": "prismlauncher",
          "args": [
            "--launch",
            "$INSTANCE_ID"
          ],
          "sidecar": false
        },
        {
          "name": "prismlauncher",
          "cmd": "prismlauncher",
          "args": [
            "--show",
            "$INSTANCE_ID"
          ],
          "sidecar": false
        }
      ]
    }
  ]
}